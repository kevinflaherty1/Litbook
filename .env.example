# Copy to .env.local. Values below match `pnpm db:start` (local Supabase).
# For a hosted project, use Project Settings → API Keys.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) — printed by `supabase status`
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only, bypasses RLS. Never expose it.
SUPABASE_SECRET_KEY=

# Show "Continue with Google". Also enable [auth.external.google] in supabase/config.toml.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: transactional email for team invites. Without it, invite links
# are shown to the inviter to share manually.
RESEND_API_KEY=
EMAIL_FROM="Litbook <onboarding@resend.dev>"
# Local only: without RESEND_API_KEY, deliver emails to Mailpit (http://127.0.0.1:54324).
MAILPIT_URL=http://127.0.0.1:54324

# Vercel Cron bearer token for /api/cron/* (guest reminders). Unset: cron is off.
CRON_SECRET=

# Optional: Stripe billing. Billing (and the paywall on creating episodes and
# links) is on only when STRIPE_SECRET_KEY is set; then the next two are required.
# Local webhooks: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The recurring price for Litbook Pro ($29/mo).
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=14
